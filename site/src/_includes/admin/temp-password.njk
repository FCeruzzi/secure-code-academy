{# Password temporanea appena generata: si vede solo qui, una volta. #}
<template x-if="issued">
<div class="mb-6 rounded-xl border border-amber-500/40 bg-amber-500/10 p-4">
  <p class="text-sm text-amber-200 mb-2">
    Password temporanea di <strong x-text="issued.username"></strong>, valida fino a
    <span x-text="formatDateTime(issued.expires_at)"></span>. Comunicala al collega di persona o su un
    canale fidato: non verrà più mostrata. Al primo accesso dovrà sceglierne una propria.
  </p>
  <div class="flex items-center gap-2">
    <code class="rounded-lg bg-slate-950 px-3 py-2 text-lg tracking-wider text-slate-100 select-all" x-text="issued.temporary_password"></code>
    <button type="button" @click="copyIssued()" class="rounded-lg border border-slate-700 px-3 py-2 text-sm hover:bg-slate-800" x-text="copied ? 'Copiata' : 'Copia'"></button>
  </div>
</div>
</template>
