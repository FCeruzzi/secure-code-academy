{#- Campi dei form del pannello, con lo stesso aspetto di _form_fields.html.
    Lo scope Alpine deve avere `form` (i valori) ed `errors` ({campo: [messaggi]}). #}
{% set inputClass = "w-full rounded-lg bg-slate-900 border border-slate-700 px-3 py-2 text-slate-100 focus:border-emerald-500 outline-none font-[inherit]" %}

{% macro errorsOf(name) %}<template x-for="e in (errors['{{ name }}'] || [])"><p class="text-xs text-rose-400 mt-1" x-text="e"></p></template>{% endmacro %}

{% macro label(name, text, required) %}<label for="f-{{ name }}" class="block text-sm font-medium mb-1 text-slate-300">{{ text }}{% if required %} <span class="text-rose-400">*</span>{% endif %}</label>{% endmacro %}

{% macro input(name, text, type="text", required=false, help="", attrs="") %}
<div class="mb-4">
  {{ label(name, text, required) }}
  <input id="f-{{ name }}" type="{{ type }}" x-model="form.{{ name }}" {% if required %}required{% endif %} {{ attrs | safe }}
         class="w-full rounded-lg bg-slate-900 border border-slate-700 px-3 py-2 text-slate-100 focus:border-emerald-500 outline-none font-[inherit]">
  {% if help %}<p class="text-xs text-slate-500 mt-1">{{ help | safe }}</p>{% endif %}
  {{ errorsOf(name) }}
</div>
{% endmacro %}

{% macro textarea(name, text, rows=3, required=false, help="", extra="") %}
<div class="mb-4">
  {{ label(name, text, required) }}
  <textarea id="f-{{ name }}" rows="{{ rows }}" x-model="form.{{ name }}" {% if required %}required{% endif %}
            class="w-full rounded-lg bg-slate-900 border border-slate-700 px-3 py-2 text-slate-100 focus:border-emerald-500 outline-none font-[inherit] {{ extra }}"></textarea>
  {% if help %}<p class="text-xs text-slate-500 mt-1">{{ help | safe }}</p>{% endif %}
  {{ errorsOf(name) }}
</div>
{% endmacro %}

{% macro checkbox(name, text, help="") %}
<div class="mb-4">
  <label class="flex items-center gap-2 text-sm text-slate-300 w-fit"{% if help %} title="{{ help | striptags }}"{% endif %}>
    <input type="checkbox" x-model="form.{{ name }}" class="h-4 w-4 rounded border-slate-600 bg-slate-900 accent-emerald-500">
    <span>{{ text }}</span>
    {% if help %}<span class="text-slate-500 cursor-help" aria-hidden="true">ⓘ</span>{% endif %}
  </label>
  {% if help %}<p class="text-xs text-slate-500 mt-1">{{ help | safe }}</p>{% endif %}
  {{ errorsOf(name) }}
</div>
{% endmacro %}

{#- Select con opzioni da un'espressione Alpine che produce [[valore, etichetta], ...]. #}
{% macro select(name, text, options, required=false, help="", blank="---------") %}
<div class="mb-4">
  {{ label(name, text, required) }}
  <select id="f-{{ name }}" x-model="form.{{ name }}" {% if required %}required{% endif %}
          class="w-full rounded-lg bg-slate-900 border border-slate-700 px-3 py-2 text-slate-100 focus:border-emerald-500 outline-none font-[inherit]">
    {% if blank %}<option value="">{{ blank }}</option>{% endif %}
    <template x-for="opt in {{ options }}" :key="opt[0]">
      <option :value="opt[0]" x-text="opt[1]" :selected="String(opt[0]) === String(form.{{ name }})"></option>
    </template>
  </select>
  {% if help %}<p class="text-xs text-slate-500 mt-1">{{ help | safe }}</p>{% endif %}
  {{ errorsOf(name) }}
</div>
{% endmacro %}

{% macro fileInput(text) %}
<div class="mb-4">
  <label class="block text-sm font-medium mb-1 text-slate-300">{{ text }} <span class="text-rose-400">*</span></label>
  <input type="file" accept="application/json,.json" required x-ref="file"
         class="w-full rounded-lg bg-slate-900 border border-slate-700 px-3 py-2 text-slate-100 focus:border-emerald-500 outline-none font-[inherit]">
  <template x-if="fileError"><p class="text-xs text-rose-400 mt-1" x-text="fileError"></p></template>
</div>
{% endmacro %}
