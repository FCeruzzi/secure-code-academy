{#- Risposta corretta più la scelta di chi ha risposto. Scope Alpine: q, rv
    (con rv?.solution e rv?.submitted). #}
<template x-if="q?.qtype === 'TRUE_FALSE'">
  <div class="flex flex-wrap items-stretch gap-3">
    <div class="rounded-xl border-2 border-emerald-500 bg-emerald-500/15 px-4 py-2">
      <div class="text-xs font-semibold uppercase tracking-wide text-emerald-300">✓ Risposta corretta</div>
      <div class="text-2xl font-extrabold text-emerald-300" x-text="rv?.solution?.answer ? 'VERO' : 'FALSO'"></div>
    </div>
    <template x-if="typeof rv?.submitted?.answer === 'boolean' && rv.submitted.answer !== rv?.solution?.answer">
      <div class="rounded-xl border-2 border-rose-500/70 bg-rose-500/10 px-4 py-2">
        <div class="text-xs font-semibold uppercase tracking-wide text-rose-300">✗ La tua risposta</div>
        <div class="text-2xl font-extrabold text-rose-300" x-text="rv.submitted.answer ? 'VERO' : 'FALSO'"></div>
      </div>
    </template>
  </div>
</template>

<template x-if="q?.qtype === 'MULTIPLE_CHOICE'">
  <div class="space-y-2">
    <template x-for="(opt, i) in (q?.options || [])" :key="opt.id">
      <div class="rounded-lg p-3 flex items-center gap-3"
        :class="(rv?.solution?.correct || []).includes(opt.id) ? 'border-2 border-emerald-500 bg-emerald-500/15' : ((rv?.submitted?.selected || []).includes(opt.id) ? 'border-2 border-rose-500/70 bg-rose-500/10' : 'border border-slate-800')">
        <span class="font-mono text-xs uppercase text-slate-500" x-text="'ABCDEFGHIJKLMNOP'[i]"></span>
        <span class="flex-1" x-text="opt.text"></span>
        <template x-if="(rv?.solution?.correct || []).includes(opt.id)">
          <span class="shrink-0 rounded-md bg-emerald-500 px-2 py-0.5 text-xs font-bold text-slate-950"
            x-text="(rv?.submitted?.selected || []).includes(opt.id) ? '✓ Corretta · la tua' : '✓ Corretta'"></span>
        </template>
        <template x-if="!(rv?.solution?.correct || []).includes(opt.id) && (rv?.submitted?.selected || []).includes(opt.id)">
          <span class="shrink-0 rounded-md bg-rose-500 px-2 py-0.5 text-xs font-bold text-slate-950">✗ La tua risposta</span>
        </template>
      </div>
    </template>
  </div>
</template>

<template x-if="q?.qtype === 'FIND_WRONG_LINE'">
  {#- Un progetto si apre sul file con la riga esatta. #}
  <div x-data="{ f: 0 }"
    x-effect="f = Math.max(0, (q?.code_files || []).findIndex((file) => file.lines.some((l) => (rv?.solution?.correct_keys || []).includes(l.key))))">
    <div class="flex overflow-hidden rounded-xl border border-slate-800 bg-slate-950">
      <template x-if="q?.is_project">
        <div class="w-44 shrink-0 border-r border-slate-800 bg-slate-950/70 py-1 max-h-[46vh] overflow-y-auto">
          <template x-for="file in (q?.code_files || [])" :key="file.index">
            <button type="button" @click="f = file.index" :title="file.name"
              :class="f === file.index ? 'bg-slate-800 text-emerald-300' : 'text-slate-400 hover:bg-slate-800/50'"
              class="flex w-full items-center gap-1.5 px-2.5 py-1 text-left font-mono text-xs">
              <span class="text-slate-600">📄</span><span class="truncate" x-text="file.name"></span>
            </button>
          </template>
        </div>
      </template>
      <div class="min-w-0 flex-1 max-h-[46vh] overflow-y-auto text-sm leading-6">
        <template x-for="file in (q?.code_files || [])" :key="file.index">
          <div x-show="f === file.index">
            <template x-if="q?.is_project">
              <div class="sticky top-0 border-b border-slate-800 bg-slate-900/95 px-3 py-1 font-mono text-xs text-slate-400" x-text="file.name"></div>
            </template>
            <template x-for="line in file.lines" :key="line.key">
              <div class="flex items-center gap-3 px-3 py-0.5"
                :class="(rv?.solution?.correct_keys || []).includes(line.key) ? 'bg-emerald-500/25 border-l-4 border-emerald-500' : ((rv?.solution?.chosen_keys || []).includes(line.key) ? 'bg-rose-500/20 border-l-4 border-rose-500' : '')">
                <span class="w-8 shrink-0 text-right text-slate-600 select-none" x-text="line.number"></span>
                <span class="highlight whitespace-pre overflow-x-auto" x-html="line.html"></span>
                <template x-if="(rv?.solution?.correct_keys || []).includes(line.key)">
                  <span class="ml-auto shrink-0 rounded-md bg-emerald-500 px-1.5 text-xs font-bold text-slate-950 select-none">◀ riga errata</span>
                </template>
                <template x-if="!(rv?.solution?.correct_keys || []).includes(line.key) && (rv?.solution?.chosen_keys || []).includes(line.key)">
                  <span class="ml-auto shrink-0 rounded-md bg-rose-500 px-1.5 text-xs font-bold text-slate-950 select-none">◀ la tua scelta</span>
                </template>
              </div>
            </template>
          </div>
        </template>
      </div>
    </div>
    <p class="text-sm mt-2">Riga/e corretta/e: <strong class="text-emerald-300" x-text="(rv?.solution?.correct_lines || []).join(', ')"></strong></p>
  </div>
</template>

<template x-if="q?.qtype === 'CODE_COMPARISON'">
  <div x-data="{ f: 0 }" class="overflow-hidden rounded-xl border border-emerald-500/50">
    <div class="flex items-center gap-2 border-b border-slate-700 bg-emerald-500/10 px-3 py-2 text-xs font-semibold text-emerald-300">
      {#- L'etichetta del pannello in cui il codice corretto era mostrato. #}
      ✓ Versione corretta: <span x-text="(rv?.solution?.correct === 'a') !== Boolean(q?.cc_swap) ? q?.label_a : q?.label_b"></span>
    </div>
    <div class="flex">
      <div class="w-36 shrink-0 border-r border-slate-800 bg-slate-950/70 py-1 max-h-[46vh] overflow-y-auto">
        <template x-for="(file, i) in ((rv?.solution?.correct === 'a' ? q?.files_a : q?.files_b) || [])" :key="i">
          <button type="button" @click="f = i" :title="file.name"
            :class="f === i ? 'bg-slate-800 text-emerald-300' : 'text-slate-400 hover:bg-slate-800/50'"
            class="flex w-full items-center gap-1.5 px-2.5 py-1 text-left font-mono text-xs">
            <span class="text-slate-600">📄</span><span class="truncate" x-text="file.name || 'codice'"></span>
          </button>
        </template>
      </div>
      <div class="min-w-0 flex-1 bg-slate-950">
        <template x-for="(file, i) in ((rv?.solution?.correct === 'a' ? q?.files_a : q?.files_b) || [])" :key="i">
          <pre x-show="f === i" class="highlight max-h-[46vh] overflow-auto p-3 text-sm leading-6"><code x-html="file.html"></code></pre>
        </template>
      </div>
    </div>
  </div>
</template>
