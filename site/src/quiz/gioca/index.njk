---
layout: layouts/base.njk
title: Quiz · Secure Code Academy
mainWidth: max-w-none
---
{% set variant = 'quiz' %}
<div x-data="quizPlayPage" x-init="load()">
{% include "partials/loading.njk" %}
<template x-if="state === 'ready'">
<div class="w-full">
  <nav class="text-sm text-slate-400 mb-4 max-w-2xl mx-auto">
    <a :href="mcUrl()" class="hover:text-slate-200">← Esci dal quiz</a>
  </nav>

  {# Domanda #}
  <template x-if="!feedback">
    <div id="quiz-card" class="mx-auto rounded-2xl border border-slate-800 bg-slate-900/50 p-6"
         :class="wide ? 'w-full max-w-none' : 'max-w-2xl'">
      <div class="flex items-center justify-between text-xs text-slate-500 mb-3">
        <span x-text="`Domanda ${index + 1} di ${questions.length}`"></span>
        <span class="rounded-md bg-slate-800 px-2 py-0.5" x-text="q?.qtype_label"></span>
      </div>
      <div class="h-1.5 w-full rounded-full bg-slate-800 mb-5 overflow-hidden">
        <div class="h-full bg-violet-500" :style="`width: ${widthPct(index + 1, questions.length)}%`"></div>
      </div>

      <div class="prose prose-invert max-w-none mb-5" x-html="q?.prompt_html"></div>

      <form @submit.prevent="submit()">
        {% include "partials/question-inputs.njk" %}
        <p x-show="submitError" class="mt-3 text-sm text-rose-300" x-text="submitError"></p>
        <button type="submit" :disabled="busy"
          class="mt-6 w-full rounded-xl bg-emerald-500 px-5 py-3 font-semibold text-slate-950 hover:bg-emerald-400 transition disabled:opacity-60">
          Conferma risposta
        </button>
      </form>
    </div>
  </template>

  {# Riscontro dopo la risposta #}
  <template x-if="feedback">
    <div id="quiz-card" class="mx-auto rounded-2xl border bg-slate-900/50 p-6"
         :class="[wide ? 'w-full max-w-none' : 'max-w-2xl', feedback?.correct ? 'border-emerald-500/50' : 'border-rose-500/50']">
      <div class="flex items-center justify-between text-xs text-slate-500 mb-3">
        <span x-text="`Domanda ${index + 1} di ${questions.length}`"></span>
        <span class="rounded-md bg-slate-800 px-2 py-0.5" x-text="q?.qtype_label"></span>
      </div>

      <template x-if="feedback?.correct">
        <div class="reveal-pop mb-4 flex items-center gap-3 rounded-xl bg-emerald-500 px-4 py-3 text-slate-950" role="status">
          <span class="text-3xl leading-none" aria-hidden="true">🎉</span><span class="text-xl font-extrabold">Risposta corretta!</span>
        </div>
      </template>
      <template x-if="!feedback?.correct">
        <div class="reveal-pop mb-4 flex items-center gap-3 rounded-xl bg-rose-500 px-4 py-3 text-slate-950" role="status">
          <span class="text-3xl font-black leading-none" aria-hidden="true">✗</span><span class="text-xl font-extrabold">Risposta sbagliata: ecco quella giusta</span>
        </div>
      </template>

      <div class="prose prose-invert max-w-none mb-4" x-html="q?.prompt_html"></div>
      <template x-if="q?.qtype === 'TRUE_FALSE' && q?.statement_html">
        <div class="prose prose-invert max-w-none mb-4 rounded-lg border border-slate-800 bg-slate-950/60 p-3 text-slate-200" x-html="q?.statement_html"></div>
      </template>

      {% include "partials/answer-reveal.njk" %}

      <template x-if="feedback?.explanation_html">
        <div class="mt-4 rounded-xl border border-slate-800 bg-slate-950/60 p-4">
          <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1">Spiegazione</div>
          <div class="prose prose-invert prose-sm max-w-none" x-html="feedback?.explanation_html"></div>
        </div>
      </template>

      <button type="button" @click="next()"
        class="mt-6 w-full rounded-xl bg-violet-500 px-5 py-3 font-semibold text-slate-950 hover:bg-violet-400 transition"
        x-text="isLast ? 'Vedi risultati →' : 'Avanti →'"></button>
    </div>
  </template>
</div>
</template>
</div>
