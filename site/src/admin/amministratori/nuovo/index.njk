---
layout: layouts/admin.njk
title: Nuovo amministratore · Pannello
navActive: amministratori
---
{% import "forms.njk" as f %}
<div x-data="adminAdminCreate">
<div class="flex items-center justify-between gap-4 mb-6"><h1 class="text-2xl font-bold">Nuovo amministratore</h1></div>
{% include "partials/loading.njk" %}
<template x-if="state === 'ready'">
<div>
{% include "admin/temp-password.njk" %}
<template x-if="issued">
  <a href="/admin/amministratori/" class="inline-block rounded-lg border border-slate-700 px-5 py-2.5 hover:bg-slate-800 transition">← Torna agli amministratori</a>
</template>
<template x-if="!issued">
<form @submit.prevent="submit()" class="max-w-2xl">
  <div class="mb-4">
    <label for="f-username" class="block text-sm font-medium mb-1 text-slate-300">Username <span class="text-rose-400">*</span></label>
    <select id="f-username" x-model="form.username" required class="w-full rounded-lg bg-slate-900 border border-slate-700 px-3 py-2 text-slate-100 focus:border-emerald-500 outline-none font-[inherit]">
      <template x-for="u in available" :key="u"><option :value="u" x-text="u"></option></template>
    </select>
    <p class="text-xs text-slate-500 mt-1" x-text="available.length ? 'Gli username autorizzati sono fissati nella configurazione del server (ADMIN_USERNAMES).' : 'Tutti gli username autorizzati hanno già un account.'"></p>
    {{ f.errorsOf("username") }}
  </div>
  {{ f.input("confirm_password", "La tua password", type="password", required=true, help="Per confermare l'operazione. Verrà generata una password temporanea, valida 24 ore, da comunicare al collega.", attrs='autocomplete="current-password"') }}
  <div class="flex gap-3 mt-6">
    <button type="submit" :disabled="busy" class="rounded-lg bg-emerald-500 px-5 py-2.5 font-semibold text-slate-950 hover:bg-emerald-400 transition disabled:opacity-60">💾 Salva</button>
    <a href="/admin/amministratori/" class="rounded-lg border border-slate-700 px-5 py-2.5 hover:bg-slate-800 transition">Annulla</a>
  </div>
</form>
</template>
</div>
</template>
</div>
