---
layout: layouts/admin.njk
title: Importa bundle JSON · Pannello
navActive: corsi
---
{% import "forms.njk" as f %}
<div x-data="adminBundleImport">
<div class="flex items-center justify-between gap-4 mb-6"><h1 class="text-2xl font-bold">Importa bundle JSON</h1></div>
<div class="max-w-2xl">
  <p class="text-sm text-slate-400 mb-4">Carica un file JSON che descrive un microcorso completo: slide (in Markdown), immagini e domande del quiz. Il microcorso viene creato o aggiornato (le slide vengono sostituite).</p>

  <form @submit.prevent="submit()" class="mb-8">
    {{ f.fileInput("File JSON del bundle") }}
    <button type="submit" :disabled="busy" class="rounded-lg bg-emerald-500 px-5 py-2.5 font-semibold text-slate-950 hover:bg-emerald-400 transition disabled:opacity-60">⬆ Importa</button>
    <a href="/admin/corsi/" class="ml-2 rounded-lg border border-slate-700 px-5 py-2.5 hover:bg-slate-800 transition">Annulla</a>
  </form>

  <details class="rounded-xl border border-slate-800 bg-slate-900/40 p-4">
    <summary class="cursor-pointer font-medium">📄 Struttura del file JSON</summary>
    <pre class="mt-3 text-xs overflow-x-auto text-slate-300"><code>{
  "version": "1.0",
  "microcourse": {
    "course_slug": "sql-injection", "course_title": "SQL Injection",
    "slug": "intro-sqli", "title": "Introduzione alla SQL Injection",
    "summary": "...", "is_published": true, "order": 1
  },
  "images": [
    { "ref_key": "schema", "alt_text": "...", "url": "https://cdn.esempio.it/img/schema.png" }
  ],
  "slides": [
    { "order": 1, "section": "ATTACK", "title": "L'attacco", "body_markdown": "Testo... ```sql\nSELECT ...```" }
  ],
  "quiz": {
    "title": "Quiz",
    "questions": [
      { "qtype": "TRUE_FALSE", "prompt": "...", "explanation": "...",
        "data": { "statement": "...", "answer": true } },
      { "qtype": "MULTIPLE_CHOICE", "prompt": "...",
        "data": { "multiple": true, "options": [{"id":"a","text":"..."}], "correct": ["a"] } },
      { "qtype": "FIND_WRONG_LINE", "prompt": "...",
        "data": { "language": "python", "code": "riga1\nriga2", "correct_lines": [2], "start_line": 1 } },
      { "qtype": "CODE_COMPARISON", "prompt": "...",
        "data": { "language": "python", "snippet_a": "...", "snippet_b": "...", "correct": "a" } }
    ]
  }
}</code></pre>
  </details>
</div>
</div>
