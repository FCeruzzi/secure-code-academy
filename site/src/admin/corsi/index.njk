---
layout: layouts/admin.njk
title: Corsi · Pannello
navActive: corsi
---
<div x-data="adminCourseList">
<div class="flex items-center justify-between gap-4 mb-6">
  <h1 class="text-2xl font-bold">Corsi</h1>
  <div class="flex items-center gap-2">
    <a href="/admin/corsi/importa/" class="rounded-lg border border-slate-700 px-4 py-2 text-sm hover:bg-slate-800 transition">⬆ Importa corso</a>
    <a href="/admin/corsi/nuovo/" class="rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-emerald-400 transition">➕ Nuovo corso</a>
  </div>
</div>
{% include "partials/loading.njk" %}
<template x-if="state === 'ready'">
<div class="overflow-x-auto rounded-xl border border-slate-800">
  <table class="w-full text-sm">
    <thead class="bg-slate-900/70 text-slate-400 text-left">
      <tr><th class="px-4 py-3">Corso</th><th class="px-4 py-3">Microcorsi</th><th class="px-4 py-3">Stato</th><th class="px-4 py-3"></th></tr>
    </thead>
    <tbody class="divide-y divide-slate-800">
      <template x-for="c in courses" :key="c.id">
        <tr>
          <td class="px-4 py-3"><span class="mr-2" x-text="c.icon || '🧩'"></span><span class="font-medium" x-text="c.title"></span><div class="text-xs text-slate-500" x-text="'/' + c.slug"></div></td>
          <td class="px-4 py-3" x-text="c.mc_count"></td>
          <td class="px-4 py-3">
            <template x-if="c.is_published"><span class="rounded-md bg-emerald-500/15 text-emerald-300 px-2 py-0.5 text-xs">Pubblicato</span></template>
            <template x-if="!c.is_published"><span class="rounded-md bg-slate-700 text-slate-300 px-2 py-0.5 text-xs">Bozza</span></template>
          </td>
          <td class="px-4 py-3 text-right whitespace-nowrap">
            <a :href="url('admin/microcorsi/', { corso: c.id })" class="text-xs rounded-md border border-slate-700 px-3 py-1 hover:bg-slate-800">Microcorsi</a>
            <button type="button" @click="exportCourse(c)" class="text-xs rounded-md border border-slate-700 px-3 py-1 hover:bg-slate-800">⬇ Esporta</button>
            <a :href="url('admin/corsi/modifica/', { id: c.id })" title="Modifica" aria-label="Modifica" class="inline-flex items-center rounded-md border border-slate-700 px-2 py-1.5 hover:bg-slate-800">{% include "partials/icon-pencil.njk" %}</a>
            <button type="button" @click="remove(c)" title="Elimina" aria-label="Elimina" class="inline-flex items-center rounded-md border border-rose-700/50 text-rose-300 px-2 py-1.5 hover:bg-rose-500/10">{% include "partials/icon-trash.njk" %}</button>
          </td>
        </tr>
      </template>
      <template x-if="!courses.length">
        <tr><td colspan="4" class="px-4 py-6 text-center text-slate-500">Nessun corso. Creane uno o importa un bundle JSON.</td></tr>
      </template>
    </tbody>
  </table>
</div>
</template>
</div>
