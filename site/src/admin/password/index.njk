---
layout: layouts/admin.njk
title: Cambia password · Pannello
---
{% import "forms.njk" as f %}
<div x-data="adminPassword">
<div class="flex items-center justify-between gap-4 mb-6"><h1 class="text-2xl font-bold">Cambia password</h1></div>
<form @submit.prevent="submit()" class="max-w-xl">
  {{ f.input("old_password", "Password attuale", type="password", required=true, attrs='autocomplete="off" autofocus') }}
  {{ f.input("new_password1", "Nuova password", type="password", required=true, attrs='autocomplete="off"', help="<ul><li>La password non può essere troppo simile alle altre tue informazioni personali.</li><li>La password deve contenere almeno 8 caratteri.</li><li>La password non può essere una password comunemente usata.</li><li>La password non può essere interamente numerica.</li></ul>") }}
  {{ f.input("new_password2", "Conferma nuova password", type="password", required=true, attrs='autocomplete="off"') }}
  <div class="flex gap-3 mt-6">
    <button type="submit" :disabled="busy" class="rounded-lg bg-emerald-500 px-5 py-2.5 font-semibold text-slate-950 hover:bg-emerald-400 transition disabled:opacity-60">🔑 Aggiorna password</button>
    <a href="/admin/" class="rounded-lg border border-slate-700 px-5 py-2.5 hover:bg-slate-800 transition">Annulla</a>
  </div>
</form>
</div>
