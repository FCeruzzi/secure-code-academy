---
layout: layouts/admin.njk
title: Importa domande · Pannello
navActive: domande
---
{% import "forms.njk" as f %}
<div x-data="adminQuestionImport">
<div class="flex items-center justify-between gap-4 mb-6"><h1 class="text-2xl font-bold">Importa domande (JSON)</h1></div>
<div class="max-w-2xl">
  <nav class="text-sm text-slate-400 mb-4"><a href="/admin/domande/" class="hover:text-slate-200">← Banca domande</a></nav>
  <p class="text-sm text-slate-400 mb-4">Carica un file JSON esportato dalla banca domande. Le domande vengono <strong>aggiunte</strong> a quelle esistenti (gli argomenti mancanti vengono creati).</p>

  <form @submit.prevent="submit()" class="mb-8">
    {{ f.fileInput("File JSON delle domande") }}
    <button type="submit" :disabled="busy" class="rounded-lg bg-emerald-500 px-5 py-2.5 font-semibold text-slate-950 hover:bg-emerald-400 transition disabled:opacity-60">⬆ Importa</button>
    <a href="/admin/domande/" class="ml-2 rounded-lg border border-slate-700 px-5 py-2.5 hover:bg-slate-800 transition">Annulla</a>
  </form>

  <details class="rounded-xl border border-slate-800 bg-slate-900/40 p-4">
    <summary class="cursor-pointer font-medium">📄 Struttura del file JSON</summary>
    <pre class="mt-3 text-xs overflow-x-auto text-slate-300"><code>{
  "version": "1.0",
  "kind": "questions",
  "questions": [
    { "qtype": "TRUE_FALSE", "prompt": "...", "explanation": "...",
      "course_slug": "sql-injection", "course_title": "SQL Injection",
      "difficulty": 1, "is_active": true,
      "data": { "statement": "...", "answer": true } }
  ]
}</code></pre>
  </details>
</div>
</div>
