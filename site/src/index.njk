---
layout: layouts/base.njk
title: Secure Code Academy · Impara a scrivere codice sicuro
---
<div x-data="homePage" x-init="load()">
<section class="text-center py-10">
  <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">
    Impara la <span class="text-emerald-400">sicurezza del codice</span>, una sfida alla volta
  </h1>
  <p class="mt-4 max-w-2xl mx-auto text-lg font-medium text-slate-200">
    Microcorsi interattivi su vulnerabilità reali
  </p>
  <p class="mt-1 max-w-2xl mx-auto text-slate-400">
    Teoria, esempi di codice e quiz pratici. Mettiti alla prova e partecipa ai tornei.
  </p>

  <template x-if="openTournament">
    <a :href="url('t/', { k: openTournament.join_token })"
       class="mt-6 inline-flex items-center gap-3 rounded-2xl border border-amber-500/40 bg-amber-500/10 px-6 py-3 text-left hover:bg-amber-500/15 transition">
      <span class="text-3xl">🏆</span>
      <span>
        <span class="block font-semibold text-amber-200">Torneo aperto: <span x-text="openTournament.title"></span></span>
        <span class="block text-sm text-amber-300/80">Iscrizioni aperte — unisciti ora →</span>
      </span>
    </a>
  </template>
</section>

<section class="mt-6">
  <h2 class="text-xl font-semibold mb-4 flex items-center gap-2">📚 Corsi</h2>
  <template x-if="state === 'loading'"><div class="py-10 text-center text-sm text-slate-500">Caricamento…</div></template>
  <template x-if="state === 'error'"><div class="rounded-2xl border border-dashed border-rose-500/40 p-10 text-center text-rose-300" x-text="error"></div></template>
  <template x-if="state === 'ready' && courses.length">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <template x-for="course in courses" :key="course.slug">
        <a :href="url('corso/', { c: course.slug })"
           class="group rounded-2xl border border-slate-800 bg-slate-900/50 p-5 hover:border-emerald-500/50 hover:bg-slate-900 transition">
          <div class="text-3xl" x-text="course.icon || '🧩'"></div>
          <h3 class="mt-3 font-semibold text-lg group-hover:text-emerald-400 transition" x-text="course.title"></h3>
          <p class="mt-1 text-sm text-slate-400 line-clamp-3" x-text="course.description"></p>
          <div class="mt-4 text-xs text-slate-500" x-text="`${course.mc_count} microcors${course.mc_count === 1 ? 'o' : 'i'}`"></div>
        </a>
      </template>
    </div>
  </template>
  <template x-if="state === 'ready' && !courses.length">
    <div class="rounded-2xl border border-dashed border-slate-800 p-10 text-center text-slate-500">
      Nessun corso pubblicato. Accedi all'area admin per crearne uno.
    </div>
  </template>
</section>
</div>
