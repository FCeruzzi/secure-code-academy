---
layout: layouts/base.njk
title: Entra · Torneo
---
<div x-data="tournamentPage('join')" x-init="load()">
{% include "partials/loading.njk" %}
<template x-if="state === 'concluded'"><div>{% include "partials/t-concluded.njk" %}</div></template>
<template x-if="state === 'closed'">
  <div class="max-w-md mx-auto py-16 text-center">
    <div class="text-5xl mb-3">🔒</div>
    <h1 class="text-2xl font-bold" x-text="t.title"></h1>
    <p class="mt-3 text-slate-400">Questo torneo non è aperto alle iscrizioni in questo momento.</p>
    <a :href="url('t/classifica/', { k: token })" class="mt-6 inline-block text-amber-300 hover:underline">🏅 Vedi la classifica</a>
  </div>
</template>
<template x-if="state === 'ready'">
<div class="max-w-lg mx-auto py-8">
  <h1 class="text-2xl font-bold text-center">Entra nel torneo</h1>
  <p class="text-center text-slate-400 mt-1" x-text="t.title"></p>

  <form @submit.prevent="join()" class="mt-8 rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
    <template x-if="joinError"><div class="text-rose-300 text-sm mb-3" x-text="joinError"></div></template>

    <label class="block text-sm font-medium mb-1 text-slate-300">Scegli un nome</label>
    <input type="text" name="display_name" maxlength="40" required x-model="form.display_name"
           class="w-full rounded-lg bg-slate-900 border border-slate-700 px-3 py-2 focus:border-emerald-500 outline-none">

    <label class="block text-sm font-medium mt-5 mb-2 text-slate-300">Scegli un personaggio</label>
    <div class="grid grid-cols-6 gap-2">
      <template x-for="(a, i) in avatars" :key="a.key">
        <label class="cursor-pointer">
          <input type="radio" name="avatar" :value="a.key" x-model="form.avatar" class="peer sr-only" :required="i === 0">
          <div class="aspect-square flex items-center justify-center text-2xl rounded-xl border border-slate-700 peer-checked:border-emerald-500 peer-checked:bg-emerald-500/15 hover:border-slate-500 transition" :title="a.label" x-text="a.emoji"></div>
        </label>
      </template>
    </div>

    <button type="submit" :disabled="busy" class="mt-6 w-full rounded-xl bg-emerald-500 px-5 py-3 font-semibold text-slate-950 hover:bg-emerald-400 transition disabled:opacity-60">Entra 🚀</button>
  </form>
</div>
</template>
</div>
