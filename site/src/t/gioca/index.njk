---
layout: layouts/base.njk
title: In gioco · Torneo
mainWidth: max-w-none
---
{% set variant = 'tournament' %}
<div x-data="tournamentPage('play')" x-init="load()">
{% include "partials/loading.njk" %}
<template x-if="state === 'concluded'"><div>{% include "partials/t-concluded.njk" %}</div></template>
<template x-if="state === 'ready' && card">
<div class="flex flex-col lg:flex-row gap-6 w-full">
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2 text-sm mb-4 max-w-2xl mx-auto">
      <span class="text-2xl" x-text="avatar(me?.avatar_key)"></span>
      <span class="font-medium" x-text="me?.display_name"></span>
    </div>

    {# Intervallo fra due round #}
    <template x-if="card?.run_phase === 'INTERMISSION'">
      <div id="quiz-card" class="mx-auto max-w-2xl rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
        <div class="text-center mb-5">
          <div class="text-4xl mb-1">🏁</div>
          <h2 class="text-xl font-bold" x-text="`Round ${card?.current_round} di ${card?.num_rounds} concluso`"></h2>
          <p class="text-sm text-slate-400">Classifica provvisoria — in attesa che l'organizzatore avvii il prossimo round…</p>
        </div>
        {% include "partials/leaderboard.njk" %}
        <div class="mt-4 flex items-center justify-center gap-2 text-sm text-amber-300">
          <span class="inline-block h-2 w-2 rounded-full bg-amber-400 animate-pulse"></span> In attesa del round successivo
        </div>
      </div>
    </template>

    {# Prima del via la domanda resta sul server (dal browser si leggerebbe in anticipo):
       qui c'è solo il conto alla rovescia, e allo scadere la pagina la chiede subito. #}
    <template x-if="card?.run_phase === 'QUESTION' && !q">
      <div id="quiz-card" class="mx-auto max-w-2xl rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
        <div class="flex items-center justify-between text-xs text-slate-500 mb-3">
          <span x-text="`Domanda ${card?.index} di ${card?.total}`"></span>
        </div>
        <div class="h-1.5 w-full rounded-full bg-slate-800 mb-5 overflow-hidden">
          <div class="h-full bg-amber-500" :style="`width: ${widthPct(card?.index, card?.total)}%`"></div>
        </div>
        <div x-show="waitingStart" class="py-12 text-center">
          <div class="text-sm uppercase tracking-widest text-slate-400 mb-3">Preparati!</div>
          <div class="font-mono font-bold tabular-nums text-7xl text-sky-300" x-text="startsIn()"></div>
          <p class="mt-4 text-slate-400">La domanda compare tra pochi secondi, a tutti nello stesso momento.</p>
        </div>
        <div x-show="!waitingStart" class="py-12 text-center text-slate-400">
          <span class="inline-block h-2 w-2 rounded-full bg-sky-400 animate-pulse"></span> La domanda sta arrivando…
        </div>
      </div>
    </template>

    {# Domanda in corso #}
    <template x-if="card?.run_phase === 'QUESTION' && q">
      <div id="quiz-card" class="mx-auto rounded-2xl border border-slate-800 bg-slate-900/50 p-6"
           :class="wide ? 'w-full max-w-none' : 'max-w-2xl'">
        <div class="flex items-center justify-between text-xs text-slate-500 mb-3">
          <span x-text="`Domanda ${card?.index} di ${card?.total}`"></span>
          <span class="rounded-md bg-slate-800 px-2 py-0.5" x-text="q?.qtype_label"></span>
        </div>
        <div class="h-1.5 w-full rounded-full bg-slate-800 mb-5 overflow-hidden">
          <div class="h-full bg-amber-500" :style="`width: ${widthPct(card?.index, card?.total)}%`"></div>
        </div>

        {# Avvio della gara: qualche secondo per arrivare tutti, poi la domanda compare insieme. #}
        <div x-show="waitingStart" class="py-12 text-center">
          <div class="text-sm uppercase tracking-widest text-slate-400 mb-3">Preparati!</div>
          <div class="font-mono font-bold tabular-nums text-7xl text-sky-300" x-text="startsIn()"></div>
          <p class="mt-4 text-slate-400">La domanda compare tra pochi secondi, a tutti nello stesso momento.</p>
        </div>

        {# Timer grande: cifre e barra del tempo che resta. #}
        <template x-if="card?.deadline_ms && !waitingStart">
          <div class="mb-6 text-center" role="timer" aria-label="Tempo rimasto">
            <div class="font-mono font-bold tabular-nums leading-none text-5xl sm:text-6xl" :class="timerText()">⏱ <span x-text="clock()">--:--</span></div>
            <div class="mt-3 h-3 w-full rounded-full bg-slate-800 overflow-hidden">
              <div class="h-full rounded-full transition-[width] duration-200 ease-linear" :class="timerBar()" :style="`width: ${timePct()}%`"></div>
            </div>
          </div>
        </template>

        <div x-show="!waitingStart">
        <div class="prose prose-invert max-w-none mb-5" x-html="q?.prompt_html"></div>

        {# La risposta parte a ogni selezione e resta modificabile fino al reveal;
           solo la scelta multipla ha un pulsante di conferma (poi è bloccata). #}
        <form x-show="!expired" @submit.prevent>
          {% include "partials/question-inputs.njk" %}
        </form>

        <div class="mt-5 border-t border-slate-800 pt-4">
          <div class="flex items-center justify-between text-sm mb-2">
            <span class="text-slate-400">Hanno risposto</span>
            <span class="font-mono"><strong class="text-emerald-300" x-text="card?.answered"></strong> / <span x-text="card?.n"></span></span>
          </div>
          <div class="h-2 w-full rounded-full bg-slate-800 overflow-hidden">
            <div class="h-full bg-emerald-500 transition-all" :style="`width: ${widthPct(card?.answered, card?.n)}%`"></div>
          </div>
        </div>

        <div x-show="expired" x-cloak class="mt-4 rounded-xl bg-slate-800/50 px-4 py-6 text-center text-slate-300">
          ⏱ <strong>Tempo scaduto</strong><br>
          <span class="text-sm text-slate-400">In attesa della risposta…</span>
        </div>
        </div>
      </div>
    </template>

    {# Reveal della risposta #}
    <template x-if="card?.run_phase === 'REVEAL' && q && rv">
      <div id="quiz-card" class="mx-auto rounded-2xl border-2 bg-slate-900/50 p-6"
           :class="[wide ? 'w-full max-w-none' : 'max-w-2xl', rv?.correct ? 'border-emerald-500' : rv?.timed_out ? 'border-slate-600' : 'border-rose-500']">
        <div class="flex items-center justify-between text-xs text-slate-500 mb-3">
          <span x-text="`Domanda ${card?.index} di ${card?.total}`"></span>
          <span>Punteggio: <strong class="text-emerald-300" x-text="me?.score"></strong></span>
        </div>
        <template x-if="rv?.correct">
          <div class="reveal-pop mb-5 flex items-center gap-4 rounded-2xl bg-emerald-500 px-5 py-4 text-slate-950 shadow-lg shadow-emerald-500/30" role="status">
            <span class="text-5xl leading-none" aria-hidden="true">🎉</span>
            <div class="flex-1">
              <div class="text-2xl font-extrabold">Risposta corretta!</div>
              <div class="text-sm font-medium">Ben fatto: hai indovinato.</div>
            </div>
            <span class="rounded-xl bg-slate-950 px-4 py-2 font-mono text-2xl font-bold text-emerald-300" x-text="`+${rv?.points}`"></span>
          </div>
        </template>
        <template x-if="!rv?.correct && rv?.timed_out">
          <div class="reveal-pop mb-5 flex items-center gap-4 rounded-2xl bg-slate-700 px-5 py-4 text-slate-100" role="status">
            <span class="text-4xl leading-none" aria-hidden="true">⏱</span>
            <div><div class="text-2xl font-extrabold">Tempo scaduto</div><div class="text-sm">Ecco la risposta giusta.</div></div>
          </div>
        </template>
        <template x-if="!rv?.correct && !rv?.timed_out">
          <div class="reveal-pop mb-5 flex items-center gap-4 rounded-2xl bg-rose-500 px-5 py-4 text-slate-950" role="status">
            <span class="text-4xl font-black leading-none" aria-hidden="true">✗</span>
            <div><div class="text-2xl font-extrabold">Risposta sbagliata</div><div class="text-sm font-medium">Ecco quella giusta.</div></div>
          </div>
        </template>
        <div class="prose prose-invert max-w-none mb-4" x-html="q?.prompt_html"></div>
        <template x-if="q?.qtype === 'TRUE_FALSE' && q?.statement_html">
          <div class="prose prose-invert max-w-none mb-4 rounded-lg border border-slate-800 bg-slate-950/60 p-3 text-slate-200" x-html="q?.statement_html"></div>
        </template>
        {% include "partials/answer-reveal.njk" %}
        <template x-if="rv?.explanation_html">
          <div class="mt-4 rounded-xl border border-slate-800 bg-slate-950/60 p-4">
            <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1">Spiegazione</div>
            <div class="prose prose-invert prose-sm max-w-none" x-html="rv?.explanation_html"></div>
          </div>
        </template>
        <div class="mt-6 flex items-center justify-center gap-3 rounded-xl bg-slate-800/50 px-4 py-3 text-base text-slate-300">
          <span x-text="(card?.is_last ? (card?.current_round < card?.num_rounds ? 'Classifica del round' : 'Classifica finale') : 'Prossima domanda') + ' tra'"></span>
          <span class="font-mono text-3xl font-bold tabular-nums text-amber-300" x-text="revealSeconds()">10</span><span>s</span>
        </div>
      </div>
    </template>
  </div>

  <aside class="lg:w-72 shrink-0">
    <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-4 lg:sticky lg:top-20">
      <h2 class="text-sm font-semibold text-slate-300 mb-3">🏅 Classifica</h2>
      {% include "partials/leaderboard.njk" %}
    </div>
  </aside>
</div>
</template>
</div>
