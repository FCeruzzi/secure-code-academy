---
layout: layouts/base.njk
title: In gioco · Torneo
mainWidth: max-w-none
---
{% set variant = 'tournament' %}
<div x-data="tournamentPage('play')" x-init="load()">
{% include "partials/loading.njk" %}
<template x-if="state === 'concluded'"><div>{% include "partials/t-concluded.njk" %}</div></template>
<template x-if="state === 'ready' && card">
{#- La classifica è una barra laterale a destra, come un «tree navigator»: chiusa, una
    linguetta sul bordo dello schermo; aperta, un pannello alto quanto la finestra sopra la
    pagina. Con 📌 resta aperta e la pagina si sposta (e lascia sempre posto alla linguetta).
    Parte chiusa e il browser ricorda la scelta. #}
<div x-data="sideBoard" @keydown.escape.window="escape()" class="w-full pr-10 transition-[padding] motion-reduce:transition-none" :class="open && pinned ? 'lg:!pr-80' : ''">
  <div class="min-w-0">
    <h1 class="sr-only" x-text="`Torneo ${t?.title || ''}`"></h1>
    <div class="flex items-center gap-2 text-sm mb-4 max-w-2xl mx-auto">
      <span class="text-2xl" aria-hidden="true" x-text="avatar(me?.avatar_key)"></span>
      <span class="font-medium" x-text="me?.display_name"></span>
    </div>

    {# Intervallo fra due round #}
    <template x-if="card?.run_phase === 'INTERMISSION'">
      <div id="quiz-card" class="mx-auto max-w-2xl rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
        <div class="text-center mb-5">
          <div class="text-4xl mb-1" aria-hidden="true">🏁</div>
          <h2 data-card-title tabindex="-1" class="text-xl font-bold outline-hidden" x-text="`Round ${card?.current_round} di ${card?.num_rounds} concluso`"></h2>
          <p class="text-sm text-slate-400">Classifica provvisoria — in attesa che l'organizzatore avvii il prossimo round…</p>
        </div>
        {% include "partials/leaderboard.njk" %}
        <div class="mt-4 flex items-center justify-center gap-2 text-sm text-amber-300">
          <span class="inline-block h-2 w-2 rounded-full bg-amber-400 animate-pulse" aria-hidden="true"></span> In attesa del round successivo
        </div>
      </div>
    </template>

    {# Prima del via la domanda resta sul server (dal browser si leggerebbe in anticipo):
       qui c'è solo il conto alla rovescia, e allo scadere la pagina la chiede subito. #}
    <template x-if="card?.run_phase === 'QUESTION' && !q">
      <div id="quiz-card" class="mx-auto max-w-2xl rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
        <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
          <h2 data-card-title tabindex="-1" class="outline-hidden" x-text="`Domanda ${card?.index} di ${card?.total}`"></h2>
        </div>
        <div class="h-1.5 w-full rounded-full bg-slate-800 mb-5 overflow-hidden">
          <div class="h-full bg-amber-500" :style="`width: ${widthPct(card?.index, card?.total)}%`"></div>
        </div>
        <div x-show="waitingStart" class="py-12 text-center">
          <div class="text-sm uppercase tracking-widest text-slate-400 mb-3">Preparati!</div>
          <div class="font-mono font-bold tabular-nums text-7xl text-sky-300" x-text="startsIn()"></div>
          <p class="mt-4 text-slate-400">La domanda compare tra pochi secondi, a tutti nello stesso momento.</p>
        </div>
        <div x-show="!waitingStart" class="py-12 text-center text-slate-400">
          <span class="inline-block h-2 w-2 rounded-full bg-sky-400 animate-pulse" aria-hidden="true"></span> La domanda sta arrivando…
        </div>
      </div>
    </template>

    {# Domanda in corso #}
    {# Il bordo dice lo stato della risposta, con discrezione: una linea ambra sottile finché
       una scelta aspetta «Conferma risposta», il blu neutro della selezione dopo la conferma
       (mai verde: una risposta confermata non è una risposta giusta). #}
    <template x-if="card?.run_phase === 'QUESTION' && q">
      <div id="quiz-card" class="mx-auto rounded-2xl border bg-slate-900/50 transition-colors"
           :class="[wide ? 'w-full max-w-none' : 'max-w-2xl', q?.qtype === 'CODE_COMPARISON' ? 'p-4' : 'p-6',
                    locked ? 'border-sky-500/50' : (chosen && !expired ? '!border-amber-400/50' : 'border-slate-800')]">
        <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
          <h2 data-card-title tabindex="-1" class="outline-hidden" x-text="`Domanda ${card?.index} di ${card?.total}`"></h2>
          <span class="rounded-md bg-slate-800 px-2 py-0.5" x-text="q?.qtype_label"></span>
        </div>
        <div class="h-1.5 w-full rounded-full bg-slate-800 mb-5 overflow-hidden">
          <div class="h-full bg-amber-500" :style="`width: ${widthPct(card?.index, card?.total)}%`"></div>
        </div>

        {# Avvio della gara: qualche secondo per arrivare tutti, poi la domanda compare insieme. #}
        <div x-show="waitingStart" class="py-12 text-center">
          <div class="text-sm uppercase tracking-widest text-slate-400 mb-3">Preparati!</div>
          <div class="font-mono font-bold tabular-nums text-7xl text-sky-300" x-text="startsIn()"></div>
          <p class="mt-4 text-slate-400">La domanda compare tra pochi secondi, a tutti nello stesso momento.</p>
        </div>

        {# Timer grande: cifre e barra del tempo che resta. #}
        <template x-if="card?.deadline_ms && !waitingStart">
          <div class="mb-6 text-center" role="timer" aria-label="Tempo rimasto">
            <div class="font-mono font-bold tabular-nums leading-none text-5xl sm:text-6xl" :class="timerText()">⏱ <span x-text="clock()">--:--</span></div>
            <div class="mt-3 h-3 w-full rounded-full bg-slate-800 overflow-hidden">
              <div class="h-full rounded-full transition-[width] duration-200 ease-linear" :class="timerBar()" :style="`width: ${timePct()}%`"></div>
            </div>
          </div>
        </template>

        <div x-show="!waitingStart">
        <div class="prose prose-invert max-w-none mb-5" x-html="q?.prompt_html"></div>

        {# Ogni tipo si invia con «Conferma risposta»: solo allora la risposta conta (il bonus
           velocità parte da quel momento) e poi non cambia più. Una scelta mai confermata non
           conta. «Conferma» sta sempre in basso a sinistra; il confronto di codice è dentro
           codeCompare, così a schermo intero Sync e il tempo restano in alto e «Conferma» in
           basso a sinistra. #}
        <form x-show="!expired" @submit.prevent>
          <div x-data="codeCompare" @keydown.escape.window="escape()" @keydown.tab="trap($event)"
               :role="full ? 'dialog' : null" :aria-modal="full ? 'true' : null" :aria-label="full ? 'Confronto a schermo intero' : null"
               :class="full ? 'fixed inset-0 z-[60] flex flex-col gap-3 bg-slate-950 p-3 sm:p-4' : ''">
            <div :class="[locked ? 'opacity-75' : '', full ? 'flex min-h-0 flex-1 flex-col' : '']">
              {% include "partials/question-inputs.njk" %}
            </div>
            <div class="mt-4" :class="full ? '!mt-0' : ''">
              {% include "partials/confirm-row.njk" %}
            </div>
          </div>
        </form>

        <div class="mt-5 border-t border-slate-800 pt-4">
          <div class="flex items-center justify-between text-sm mb-2">
            <span class="text-slate-400">Hanno risposto</span>
            <span class="font-mono"><strong class="text-emerald-300" x-text="card?.answered"></strong> / <span x-text="card?.n"></span></span>
          </div>
          <div class="h-2 w-full rounded-full bg-slate-800 overflow-hidden">
            <div class="h-full bg-emerald-500 transition-all" :style="`width: ${widthPct(card?.answered, card?.n)}%`"></div>
          </div>
        </div>

        <div x-show="expired" x-cloak class="mt-4 rounded-xl bg-slate-800/50 px-4 py-6 text-center text-slate-300">
          <span aria-hidden="true">⏱</span> <strong>Tempo scaduto</strong><br>
          <span class="text-sm text-slate-400">In attesa della risposta…</span>
        </div>
        </div>
      </div>
    </template>

    {# Reveal della risposta #}
    <template x-if="card?.run_phase === 'REVEAL' && q && rv">
      <div id="quiz-card" class="mx-auto rounded-2xl border-2 bg-slate-900/50 p-6"
           :class="[wide ? 'w-full max-w-none' : 'max-w-2xl', rv?.correct ? 'border-emerald-500' : rv?.timed_out ? 'border-slate-600' : 'border-rose-500']">
        <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
          <h2 data-card-title tabindex="-1" class="outline-hidden" x-text="`Esito della domanda ${card?.index} di ${card?.total}`"></h2>
          <span>Punteggio: <strong class="text-emerald-300" x-text="me?.score"></strong></span>
        </div>
        <template x-if="rv?.correct">
          <div class="reveal-pop mb-5 flex items-center gap-4 rounded-2xl bg-emerald-500 px-5 py-4 text-slate-950 shadow-lg shadow-emerald-500/30">
            <span class="text-5xl leading-none" aria-hidden="true">🎉</span>
            <div class="flex-1">
              <div class="text-2xl font-extrabold">Risposta corretta!</div>
              <div class="text-sm font-medium">Ben fatto: hai indovinato.</div>
            </div>
            <span class="rounded-xl bg-slate-950 px-4 py-2 font-mono text-2xl font-bold text-emerald-300" x-text="`+${rv?.points}`"></span>
          </div>
        </template>
        <template x-if="!rv?.correct && rv?.timed_out">
          <div class="reveal-pop mb-5 flex items-center gap-4 rounded-2xl bg-slate-700 px-5 py-4 text-slate-100">
            <span class="text-4xl leading-none" aria-hidden="true">⏱</span>
            <div><div class="text-2xl font-extrabold">Tempo scaduto</div><div class="text-sm">Ecco la risposta giusta.</div></div>
          </div>
        </template>
        <template x-if="!rv?.correct && !rv?.timed_out">
          <div class="reveal-pop mb-5 flex items-center gap-4 rounded-2xl bg-rose-500 px-5 py-4 text-slate-950">
            <span class="text-4xl font-black leading-none" aria-hidden="true">✗</span>
            <div><div class="text-2xl font-extrabold">Risposta sbagliata</div><div class="text-sm font-medium">Ecco quella giusta.</div></div>
          </div>
        </template>
        <div class="prose prose-invert max-w-none mb-4" x-html="q?.prompt_html"></div>
        <template x-if="q?.qtype === 'TRUE_FALSE' && q?.statement_html">
          <div class="prose prose-invert max-w-none mb-4 rounded-lg border border-slate-800 bg-slate-950/60 p-3 text-slate-200" x-html="q?.statement_html"></div>
        </template>
        {% include "partials/answer-reveal.njk" %}
        <template x-if="rv?.explanation_html">
          <div class="mt-4 rounded-xl border border-slate-800 bg-slate-950/60 p-4">
            <div class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">Spiegazione</div>
            <div class="prose prose-invert prose-sm max-w-none" x-html="rv?.explanation_html"></div>
          </div>
        </template>
        <div class="mt-6 flex items-center justify-center gap-3 rounded-xl bg-slate-800/50 px-4 py-3 text-base text-slate-300">
          <span x-text="(card?.is_last ? (card?.current_round < card?.num_rounds ? 'Classifica del round' : 'Classifica finale') : 'Prossima domanda') + ' tra'"></span>
          <span class="font-mono text-3xl font-bold tabular-nums text-amber-300" x-text="revealSeconds()">10</span><span>s</span>
        </div>
      </div>
    </template>
  </div>

  <button type="button" x-show="!open" x-ref="boardTab" @click="show()" title="Mostra la classifica"
          aria-label="Mostra la classifica" :aria-expanded="open" aria-controls="side-board"
          class="fixed right-0 top-1/2 z-40 flex -translate-y-1/2 flex-col items-center gap-3 rounded-l-xl border border-r-0 border-slate-300 bg-slate-100 px-2 py-4 text-slate-700 shadow-lg shadow-black/40 hover:bg-white transition">
    <span class="text-[11px] font-semibold uppercase tracking-[0.2em] [writing-mode:vertical-rl]">Classifica</span>
    <span class="text-lg leading-none" aria-hidden="true">🏅</span>
  </button>

  <aside id="side-board" x-ref="board" x-show="open" x-cloak @click.outside="if (!pinned) close()"
         x-transition:enter="transition ease-out duration-200" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0"
         x-transition:leave="transition ease-in duration-150" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full"
         class="fixed inset-y-0 right-0 z-50 flex w-80 motion-reduce:transition-none max-w-[85vw] flex-col border-l border-slate-700 bg-slate-900 shadow-2xl shadow-black/60"
         aria-label="Classifica">
    <div class="flex items-center gap-2 border-b border-slate-800 px-4 py-3">
      <span class="text-xl" aria-hidden="true">🏅</span>
      <div class="min-w-0 flex-1">
        <h2 class="font-semibold">Classifica</h2>
        <div class="truncate text-xs text-slate-400" x-text="t?.title"></div>
      </div>
      <button type="button" @click="togglePin()" :title="pinned ? 'Sgancia la classifica' : 'Fissa la classifica'" aria-label="Tieni aperta la classifica" :aria-pressed="pinned"
              :class="pinned ? 'bg-amber-500/20 text-amber-300' : 'text-slate-400 hover:bg-slate-800'"
              class="rounded-md px-2 py-1 text-sm transition">📌</button>
      <button type="button" x-ref="boardClose" @click="close()" title="Chiudi la classifica" aria-label="Chiudi la classifica" class="rounded-md px-2 py-1 text-slate-400 hover:bg-slate-800 hover:text-slate-200">✕</button>
    </div>
    <div id="side-leaderboard" class="min-h-0 flex-1 overflow-y-auto p-3">
      {% include "partials/leaderboard.njk" %}
    </div>
  </aside>
</div>
</template>
</div>
