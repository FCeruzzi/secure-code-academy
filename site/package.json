{
  "name": "sca-site",
  "private": true,
  "version": "1.0.0",
  "description": "Sito statico di Secure Code Academy per GitHub Pages (Eleventy + Tailwind + Alpine).",
  "type": "module",
  "scripts": {
    "build:js": "node build-js.mjs",
    "build:css": "tailwindcss -i ./src/css/input.css -o ./_site/assets/app.css --minify",
    "build:html": "eleventy",
    "build": "npm run build:html && npm run build:js && npm run build:css",
    "serve": "node serve.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "alpinejs": "^3.15.12",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "chokidar": "^4.0.3",
    "argparse": "^2.0.1",
    "postcss-selector-parser": "^7.1.6",
    "@parcel/watcher": "^2.6.0",
    "finalhandler": {
      "debug": "^4.4.3"
    }
  }
}
